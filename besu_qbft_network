#!/usr/bin/bash 

# set -x
set -eo pipefail

BESU="${BESU_BIN_PATH:-besu}"

# Verify Besu is installed before doing anything else
command -v "$BESU" >/dev/null 2>&1 || { echo "Error: besu required but not installed."; exit 1; }

# Setup Base Directories
BASE_DIR="QBFT-Network"
CONFIG_FILE_NAME="qbftConfigFile.json"
NETWORK_FILE_PATH="${BASE_DIR}/networkFiles"

# Clean up any old runs
[[ -d "$BASE_DIR" ]] && rm -rf "$BASE_DIR"
mkdir -p "$BASE_DIR"

# Write the config file inside the BASE_DIR
cat << 'EOF' > "${BASE_DIR}/${CONFIG_FILE_NAME}"
{
  "genesis": {
    "config": {
      "chainId": 1337,
      "berlinBlock": 0,
      "qbft": {
        "blockperiodseconds": 2,
        "epochlength": 30000,
        "requesttimeoutseconds": 4
      }
    },
    "nonce": "0x0",
    "timestamp": "0x58ee40ba",
    "gasLimit": "0x47b760",
    "difficulty": "0x1",
    "mixHash": "0x63746963616c2062797a616e74696e65206661756c7420746f6c6572616e6365",
    "coinbase": "0x0000000000000000000000000000000000000000",
    "alloc": {
      "fe3b557e8fb62b89f4916b721be55ceb828dbd73": {
        "privateKey": "8f2a55949038a9610f50fb23b5883af3b4ecb3c3bb792cbcefbd1542c692be63",
        "comment": "private key and this comment are ignored. In a real chain, the private key should NOT be stored",
        "balance": "0xad78ebc5ac6200000"
      },
      "627306090abaB3A6e1400e9345bC60c78a8BEf57": {
        "privateKey": "c87509a1c067bbde78beb793e6fa76530b6382a4c0241e5e4a9ec0a0f44dc0d3",
        "comment": "private key and this comment are ignored. In a real chain, the private key should NOT be stored",
        "balance": "90000000000000000000000"
      },
      "f17f52151EbEF6C7334FAD080c5704D77216b732": {
        "privateKey": "ae6ae8e5ccbfb04590405997ee2d52d2b330726137b875053c36d94e974d162f",
        "comment": "private key and this comment are ignored. In a real chain, the private key should NOT be stored",
        "balance": "90000000000000000000000"
      }
    }
  },
  "blockchain": {
    "nodes": {
      "generate": true,
      "count": 4
    }
  }
}
EOF

# Execute the Besu artifact generation using the correct file pathing
"$BESU" operator generate-blockchain-config \
    --config-file="${BASE_DIR}/${CONFIG_FILE_NAME}" \
    --to="$NETWORK_FILE_PATH" \
    --private-key-file-name=key

# Check if generation succeeded
[[ -d "$NETWORK_FILE_PATH" ]] || { echo "Config files not created"; exit 1; }

# Copy genesis to the base network directory
cp "${NETWORK_FILE_PATH}/genesis.json" "${BASE_DIR}/genesis.json"

# Move the generated node keys into standard Besu node directory structures
for i in {1..4}; do 
    NODE_DIR="${BASE_DIR}/Node-${i}/data"
    mkdir -p "$NODE_DIR"
    
    # Besu outputs directories inside 'keys' named using the node's public key. 
    # This grabs them in order and copies the keys to your Node folders.
    GEN_NODE_DIR=$(ls -d ${NETWORK_FILE_PATH}/keys/* | sed -n "${i}p")
    cp -r "${GEN_NODE_DIR}/"* "$NODE_DIR/"
done

echo "Network configurations generated successfully!"
echo "-------------------------------------------------------"
echo "Starting all 4 Besu Nodes..."

# 1. Extract Node 1's Public Key to form the Bootnode Enode URL
# We assume Node 1 runs locally on standard P2P port 30303 and IP 127.0.0.1
NODE1_PUB_KEY=$(cat "${BASE_DIR}/Node-1/data/key.pub" | sed 's/^0x//')
BOOTNODE_ENODE="enode://${NODE1_PUB_KEY}@127.0.0.1:30303"

echo "Generated Bootnode Enode URL:"
echo "$BOOTNODE_ENODE"
echo "-------------------------------------------------------"

# ==============================================================================
# STARTING THE NODES USING SUBSHELLS (No path tracking bugs)
# ==============================================================================

# 2. Start Node 1 (Serving as the Bootnode)
echo "Launching Node 1..."
(
  cd "${BASE_DIR}/Node-1" || exit 1
  "$BESU" \
    --data-path=data \
    --genesis-file=../genesis.json \
    --p2p-port=30303 \
    --rpc-http-enabled \
    --rpc-http-api=ETH,NET,QBFT \
    --host-allowlist="*" \
    --rpc-http-cors-origins="all" \
    --rpc-http-port=8545 \
    --profile=ENTERPRISE > node1.log 2>&1
) &

# Give the bootnode a couple seconds to warm up and open its port
sleep 3

# 3. Start Node 2 (Connecting to Node 1)
echo "Launching Node 2..."
(
  cd "${BASE_DIR}/Node-2" || exit 1
  "$BESU" \
    --data-path=data \
    --genesis-file=../genesis.json \
    --bootnodes="$BOOTNODE_ENODE" \
    --p2p-port=30304 \
    --rpc-http-enabled \
    --rpc-http-api=ETH,NET,QBFT \
    --host-allowlist="*" \
    --rpc-http-cors-origins="all" \
    --rpc-http-port=8546 \
    --profile=ENTERPRISE > node2.log 2>&1
) &

# 4. Start Node 3 (Connecting to Node 1)
echo "Launching Node 3..."
(
  cd "${BASE_DIR}/Node-3" || exit 1
  "$BESU" \
    --data-path=data \
    --genesis-file=../genesis.json \
    --bootnodes="$BOOTNODE_ENODE" \
    --p2p-port=30305 \
    --rpc-http-enabled \
    --rpc-http-api=ETH,NET,QBFT \
    --host-allowlist="*" \
    --rpc-http-cors-origins="all" \
    --rpc-http-port=8547 \
    --profile=ENTERPRISE > node3.log 2>&1
) &

# 5. Start Node 4 (Connecting to Node 1)
echo "Launching Node 4..."
(
  cd "${BASE_DIR}/Node-4" || exit 1
  "$BESU" \
    --data-path=data \
    --genesis-file=../genesis.json \
    --bootnodes="$BOOTNODE_ENODE" \
    --p2p-port=30306 \
    --rpc-http-enabled \
    --rpc-http-api=ETH,NET,QBFT \
    --host-allowlist="*" \
    --rpc-http-cors-origins="all" \
    --rpc-http-port=8548 \
    --profile=ENTERPRISE > node4.log 2>&1
) &

echo "All nodes are launching in the background!"
echo "Check logs inside ${BASE_DIR}/Node-X/nodeX.log to see the consensus process."

